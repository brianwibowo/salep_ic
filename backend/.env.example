# Process roles: API replicas stay stateless; one worker owns the scheduler.
SALEP_PROCESS_ROLE=api
SCHEDULER_LOCK_NAME=salep-discovery-scheduler
SCHEDULER_LOCK_PATH=data/salep-scheduler.lock
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=120
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=900
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=14
SNAPSHOT_RETENTION_DAYS=90

# Persistence migration. Leave empty for the legacy local SQLite adapter.
# Production example: postgresql+psycopg://salep:password@postgres:5432/salep
# DATABASE_URL=
# DATABASE_AUTO_CREATE=false

# Authentication sessions and accounts. Production must use the shared PostgreSQL
# database so API replicas see the same revocable sessions.
# AUTH_DATABASE_URL=postgresql+psycopg://salep:password@postgres:5432/salep
AUTH_SESSION_TTL_SECONDS=28800
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_IP_LIMIT=100

# Discovery (single application worker; use the UI to save keywords in data/discovery.json)
AUTO_SEARCH_ENABLED=true
AUTO_SEARCH_INTERVAL_MINUTES=30
AUTO_SEARCH_SOURCES=threads
AUTO_SEARCH_LIMIT_PER_RUN=5
# When DATABASE_URL is set, the same 30-minute heartbeat also syncs Si-RUP
# and the five SPSE tracks for the current and previous fiscal year.
INAPROC_AUTO_SYNC_ENABLED=true
INAPROC_SYNC_LIMIT=500
# AUTO_SEARCH_KEYWORDS=butuh website,rekomendasi hosting,butuh server VPS,cari managed service,migrasi cloud,vendor jaringan kantor,jasa pentest,solusi backup data,implementasi ERP,rekomendasi CRM
