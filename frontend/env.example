# Root URL backend FastAPI; jangan tambahkan /api/v1 di akhir.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Target backend untuk server-side proxy /api/*.
# Lokal: gunakan http://localhost:8000 setelah SSH tunnel database/backend siap.
# Staging: default ke https://salep-staging.icdigital.io bila tidak diisi.
BACKEND_PROXY_URL=http://localhost:8000
