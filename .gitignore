# ==============================================================================
# SALEP Monorepo .gitignore (Root)
# Combined rules for Backend (FastAPI / Python) & Frontend (Next.js / TypeScript)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
.env.production
.env.staging
!.env.example
*.pem
service-account.json
*.json.key

# ------------------------------------------------------------------------------
# 2. Frontend (Node.js / Next.js)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build & output
.next/
out/
build/
dist/

# Vercel & TypeScript
.vercel/
*.tsbuildinfo
next-env.d.ts

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Backend (Python / FastAPI)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
htmlcov/
.coverage
coverage/

# Database files
*.db
*.sqlite
*.sqlite3

# Discovery runtime preferences & cache
data/discovery.json
data/discovery.tmp
backend/data/discovery.json
backend/data/discovery.tmp

# ------------------------------------------------------------------------------
# 4. Logs, Docker & OS
# ------------------------------------------------------------------------------
*.log
.docker/

# Operating System
.DS_Store
Thumbs.db

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~
